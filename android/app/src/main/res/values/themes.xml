<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.P2PCam" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:textColor">@color/ink</item>
        <item name="colorAccent">@color/ctrl</item>
    </style>

    <!-- Uppercase, widely tracked, monospaced. Used for every field label and
         readout caption; nothing sits below 11sp. -->
    <style name="Label">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Readout">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink2</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="Btn">
        <item name="android:background">@drawable/btn</item>
        <item name="android:textColor">@color/ink2</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
