<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Label"
            android:textColor="@color/faint"
            android:text="less AI · prototype" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="P2P Camera"
            android:textColor="@color/ink"
            android:textSize="34sp"
            android:letterSpacing="-0.02"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            style="@style/Body"
            android:text="Video travels directly between the two devices. The server only helps them find each other." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/line" />

        <!-- ================================================ server === -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            style="@style/Label"
            android:text="Control plane address" />

        <EditText
            android:id="@+id/serverInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/input"
            android:fontFamily="monospace"
            android:textSize="15sp"
            android:textColor="@color/ink"
            android:textColorHint="@color/faint"
            android:hint="http://192.168.0.10:8099"
            android:inputType="textUri"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:minHeight="52dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:importantForAutofill="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/selfSigned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/warn"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:text="Accept self-signed certificate" />
        </LinearLayout>

        <TextView
            android:id="@+id/serverHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/faint"
            android:lineSpacingMultiplier="1.3"
            android:text="Plain http:// is recommended — a native app has no secure-context rule, so it needs no certificate at all. Run the server with --http." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="@color/line" />

        <!-- ================================================= roles === -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            style="@style/Label"
            android:text="Choose a role" />

        <LinearLayout
            android:id="@+id/roleCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/surface"
            android:orientation="vertical"
            android:padding="18dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Label"
                android:textColor="@color/accent"
                android:text="Device" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Be the camera"
                android:textColor="@color/ink"
                android:textSize="19sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:text="Publish this phone's lens and microphone under a UID and PIN." />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/roleViewer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/surface"
            android:orientation="vertical"
            android:padding="18dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Label"
                android:textColor="@color/ctrl"
                android:text="App" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Watch a camera"
                android:textColor="@color/ink"
                android:textSize="19sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:text="Pair by UID and PIN, talk back, and save a still on the camera." />
        </LinearLayout>

        <TextView
            android:id="@+id/statusLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/faint"
            android:text="" />

    </LinearLayout>
</ScrollView>
